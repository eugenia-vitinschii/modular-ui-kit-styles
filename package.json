{
  "name": "modular-ui-kit-styles",
  "version": "1.0.6",
  "description": "Shared SASS/CSS styles and design tokens for Modular UI Kit",
  "main": "dist/index.css",
  "style": "dist/index.css",
  "sass": "styles/lib.sass",
  "exports": {
    ".": "./dist/index.css",
    "./sass": "./styles/lib.sass",
    "./dist/*": "./dist/*"
  },
  "license": "MIT",
  "keywords": [
    "ui-kit",
    "design-system",
    "design-tokens",
    "styles",
    "css",
    "sass",
    "scss",
    "css-variables",
    "modular-ui-kit",
    "vue",
    "react",
    "components",
    "responsive",
    "typography",
    "layout",
    "mixins"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugenia-vitinschii/modular-ui-kit-styles.git"
  },
  "homepage": "https://github.com/eugenia-vitinschii/modular-ui-kit-styles#readme",
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "sass styles/lib.sass dist/index.css --style=compressed --no-source-map",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "sass": "^1.80.0"
  }
}
